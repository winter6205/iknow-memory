# iknow-memory local env template (git-tracked, no secrets).
# Copy: cp .env.example .env.local
# Then fill GRAPHRAG_MEMORY_EMBED_API_KEY. .env.local is gitignored.
#
# Official Zhipu embedding-3 (OpenAI-compatible):
#   POST https://open.bigmodel.cn/api/paas/v4/embeddings
#   https://docs.bigmodel.cn/cn/guide/models/embedding/embedding-3
# NineRouterEmbedder appends /embeddings to BASE_URL.

GRAPHRAG_MEMORY_EMBED_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GRAPHRAG_MEMORY_EMBED_MODEL=embedding-3
GRAPHRAG_MEMORY_EMBED_DIMENSIONS=1536
GRAPHRAG_MEMORY_PGVECTOR_ANN_MAX_DIMENSIONS=2000

# Dedicated embedding key. Do not reuse ANTHROPIC_AUTH_TOKEN (LLM).
# GRAPHRAG_MEMORY_EMBED_API_KEY=<zhipu-api-key>
# Preferred vector alias (same role as EMBED_API_KEY):
# GRAPHRAG_MEMORY_VECTOR_API_KEY=<vector-api-key>
# Legacy vector alias (same role as EMBED_API_KEY, lower priority):
# GRAPHRAG_MEMORY_ANTHROPIC_API_KEY=<vector-api-key>

# Hybrid retrieval (vector + BM25 + Neo4j graph, fused by RRF at k=60).
# Shown at their defaults — leave them unset unless you are deliberately
# retuning recall. Weights must be finite and > 0; enable flags take
# true|false|1|0.
# GRAPHRAG_MEMORY_RETRIEVAL_W_VEC=0.7
# GRAPHRAG_MEMORY_RETRIEVAL_W_BM25=0.15
# GRAPHRAG_MEMORY_RETRIEVAL_W_GRAPH=0.15
# GRAPHRAG_MEMORY_RETRIEVAL_BM25_ENABLED=true
# GRAPHRAG_MEMORY_RETRIEVAL_GRAPH_ENABLED=true
# Optional direct Postgres entities.embedding seed/score path. Default off;
# no entity embedding is copied to or indexed by Neo4j.
# GRAPHRAG_MEMORY_RETRIEVAL_NODE_EMBEDDING_ENABLED=false
# Optional read-only wait for an external projection drain (default off).
# GRAPHRAG_MEMORY_RETRIEVAL_WAIT_FOR_DRAIN_ENABLED=false
# GRAPHRAG_MEMORY_RETRIEVAL_WAIT_FOR_DRAIN_TIMEOUT_MS=5000
# Temporary LLM rerank after ranking. Default on.
# LLM secret is ANTHROPIC_AUTH_TOKEN.
# Defaults (China MiniMax, Anthropic-compatible):
#   GRAPHRAG_MEMORY_ANTHROPIC_BASE_URL=https://api.minimaxi.com/anthropic
#   GRAPHRAG_MEMORY_ANTHROPIC_MODEL=MiniMax-M3
# Missing ANTHROPIC_AUTH_TOKEN leaves this default-on capability unattempted
# and marks retrieve degraded with rerank in degraded_reasons.
# GRAPHRAG_MEMORY_RETRIEVAL_RERANK_ENABLED=true
# Dedicated HTTP rerank endpoint. When rerank is enabled but this URL is unset,
# retrieve skips reranking and marks degraded with rerank in degraded_reasons.
# GRAPHRAG_MEMORY_RETRIEVAL_RERANK_URL=http://localhost:8080/rerank

# Neo4j sidecar (read-only projection of the Postgres ledger, ADR-0001 — fed
# by `npm run graph:backfill` and `npm run graph:drain`, read by the PPR graph
# arm). Unset URI =
# the default-on graph multi-hop capability is unattempted and marks retrieve
# degraded with graph multi-hop in degraded_reasons. Scheme must
# be bolt / bolt+s / bolt+ssc / neo4j / neo4j+s / neo4j+ssc; USER and
# PASSWORD are optional but must be set together.
#
# A local sidecar (Neo4j + GDS, no Docker needed) comes from
#   bash scripts/cursor-neo4j.sh install && bash scripts/cursor-neo4j.sh start
#   eval "$(bash scripts/cursor-neo4j.sh env)"
# That one runs with auth disabled on 127.0.0.1, so URI alone is enough.
# GRAPHRAG_MEMORY_NEO4J_URI=bolt://localhost:7687
# GRAPHRAG_MEMORY_NEO4J_USER=neo4j
# GRAPHRAG_MEMORY_NEO4J_PASSWORD=<neo4j-password>

# Elasticsearch precision layer (optional — leave the URL unset to keep
# retrieve vector-only with the lexical arm loud-skipped). When set, the
# server double-writes chunks/entities into two derived indexes
# (iknow-memory-chunks + iknow-memory-entities by default) and serves
# lexical recall through them. Server is Elasticsearch 8.x with the
# analysis-ik plugin at the matching 8.x patch version; client is
# @elastic/elasticsearch 8.x. See docs/runbooks/es-precision-layer.md
# for the deploy / install / verify / recover walkthrough.
#
# URL/NODE: a single http(s):// node URL. Either form is accepted.
# Credentials: pick ONE pair. Username + password (basic auth) OR an API
# key — they cannot be combined, and a half-declared pair is a startup
# ConfigError. Index names must be lowercase ES identifiers
# ([a-z0-9][a-z0-9_-]*), max 255 chars.
#
# GRAPHRAG_MEMORY_ES_URL=http://localhost:9200
# GRAPHRAG_MEMORY_ES_USERNAME=<es-username>
# GRAPHRAG_MEMORY_ES_PASSWORD=<es-password>
# GRAPHRAG_MEMORY_ES_API_KEY=<es-api-key>
# GRAPHRAG_MEMORY_ES_CHUNK_INDEX=iknow-memory-chunks
# GRAPHRAG_MEMORY_ES_ENTITY_INDEX=iknow-memory-entities
# GRAPHRAG_MEMORY_ES_REQUEST_TIMEOUT_MS=5000

# Precision-layer retrieval knobs (only take effect when ES is configured).
# Each flag is true|false|1|0. K1 / B must be finite positive numbers;
# FIELD_BOOSTS is a JSON object mapping field name to a finite non-negative
# weight. Defaults shown; leave them commented unless retuning.
# GRAPHRAG_MEMORY_RETRIEVAL_K1=1.2
# GRAPHRAG_MEMORY_RETRIEVAL_B=0.75
# GRAPHRAG_MEMORY_RETRIEVAL_CJK_SEGMENTATION_ENABLED=true
# GRAPHRAG_MEMORY_RETRIEVAL_PHRASE_ENABLED=true
# GRAPHRAG_MEMORY_RETRIEVAL_FIELD_BOOST_ENABLED=true
# GRAPHRAG_MEMORY_RETRIEVAL_FIELD_BOOSTS={"content":1,"source_ref":1,"metadata.*":1}
# GRAPHRAG_MEMORY_RETRIEVAL_RRF_ENABLED=true
# GRAPHRAG_MEMORY_RETRIEVAL_VECTOR_ENABLED=true
