# iknow-memory local env template (git-tracked, no secrets).
# Copy: cp .env.example .env.local
# Then fill GRAPHRAG_MEMORY_EMBED_API_KEY. .env.local is gitignored.
#
# Official Zhipu embedding-3 (OpenAI-compatible):
#   POST https://open.bigmodel.cn/api/paas/v4/embeddings
#   https://docs.bigmodel.cn/cn/guide/models/embedding/embedding-3
# NineRouterEmbedder appends /embeddings to BASE_URL.

GRAPHRAG_MEMORY_EMBED_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GRAPHRAG_MEMORY_EMBED_MODEL=embedding-3
GRAPHRAG_MEMORY_EMBED_DIMENSIONS=2048

# Dedicated embedding key. Do not reuse ANTHROPIC_AUTH_TOKEN (LLM).
# GRAPHRAG_MEMORY_EMBED_API_KEY=<zhipu-api-key>
# Preferred vector alias (same role as EMBED_API_KEY):
# GRAPHRAG_MEMORY_VECTOR_API_KEY=<vector-api-key>
# Legacy vector alias (same role as EMBED_API_KEY, lower priority):
# GRAPHRAG_MEMORY_ANTHROPIC_API_KEY=<vector-api-key>

# Hybrid retrieval (vector + BM25 + Neo4j graph, fused by RRF at k=60).
# Shown at their defaults — leave them unset unless you are deliberately
# retuning recall. Weights must be finite and > 0; enable flags take
# true|false|1|0.
# GRAPHRAG_MEMORY_RETRIEVAL_W_VEC=0.7
# GRAPHRAG_MEMORY_RETRIEVAL_W_BM25=0.15
# GRAPHRAG_MEMORY_RETRIEVAL_W_GRAPH=0.15
# GRAPHRAG_MEMORY_RETRIEVAL_BM25_ENABLED=true
# GRAPHRAG_MEMORY_RETRIEVAL_GRAPH_ENABLED=true
# Optional direct Postgres entities.embedding seed/score path. Default off;
# no entity embedding is copied to or indexed by Neo4j.
# GRAPHRAG_MEMORY_RETRIEVAL_NODE_EMBEDDING_ENABLED=false
# Temporary LLM rerank after ranking. Default off.
# LLM secret is ANTHROPIC_AUTH_TOKEN.
# Defaults (China MiniMax, Anthropic-compatible):
#   GRAPHRAG_MEMORY_ANTHROPIC_BASE_URL=https://api.minimaxi.com/anthropic
#   GRAPHRAG_MEMORY_ANTHROPIC_MODEL=MiniMax-M3
# GRAPHRAG_MEMORY_RETRIEVAL_RERANK_ENABLED=false
# Dedicated HTTP rerank endpoint. When rerank is enabled but this URL is
# unset, retrieve skips reranking without setting degraded.
# GRAPHRAG_MEMORY_RETRIEVAL_RERANK_URL=http://localhost:8080/rerank

# Neo4j sidecar (read-only projection of the Postgres ledger, ADR-0001 — fed
# by `npm run graph:backfill` and `npm run graph:drain`, read by the PPR graph
# arm). Unset URI =
# the graph arm is skipped, which is NOT a degraded retrieve. Scheme must
# be bolt / bolt+s / bolt+ssc / neo4j / neo4j+s / neo4j+ssc; USER and
# PASSWORD are optional but must be set together.
#
# A local sidecar (Neo4j + GDS, no Docker needed) comes from
#   bash scripts/cursor-neo4j.sh install && bash scripts/cursor-neo4j.sh start
#   eval "$(bash scripts/cursor-neo4j.sh env)"
# That one runs with auth disabled on 127.0.0.1, so URI alone is enough.
# GRAPHRAG_MEMORY_NEO4J_URI=bolt://localhost:7687
# GRAPHRAG_MEMORY_NEO4J_USER=neo4j
# GRAPHRAG_MEMORY_NEO4J_PASSWORD=<neo4j-password>
