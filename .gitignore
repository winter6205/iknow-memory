node_modules/
dist/
*.tsbuildinfo
coverage/

# Runtime artifacts of the eval CLI (gold-set/{baseline,thresholds}.json
# are written by --bootstrap / eval-thresholds, never committed).
gold-set/

# Local-only historical reference: archived upgrade guide, kept on disk
# for offline reading. Never re-import, re-link, or re-add to git.
docs/vector-memory-upgrade-archive.html

# Host-local env (operator secrets + endpoint overrides)
.env.local

# Machine-local Cursor MCP (absolute `node` path; Cursor spawn PATH is stripped)
.cursor/mcp.json

# Claude Code 运行时产物（post-push 钩子日志等）
.claude/scratchpad/
# Machine-local Claude permission grants. Keep .claude/settings.json.
.claude/settings.local.json

# Serena MCP 本地索引 / 缓存 / memories（机器本地，非产品源）
.serena/

.tmp-tickets
# Nested git worktrees (local checkouts, not product source)
.claude/worktrees/
.worktrees/
# Cloud start writes these; keep husky pre-commit tracked.
.husky/commit-msg
.husky/prepare-commit-msg
# Local study HTML (not iknow-memory SSOT; generated to a personal path)
.reference/

# Docs local-only (keep on disk). Product SSOT stays tracked:
# docs/CONTEXT.md, docs/adr/, specs/, docs/runbooks/, docs/mcp-config.md
docs/wayfinder/
docs/handoff/
docs/archive/
docs/visualizations/

# Release scoping: ticket-by-ticket execution plans are maintainer-local working
# material, so they stay out of this tree. Do not restore them on a source sync.
/plans/

# Private evaluation datasets and recorded results stay in the private source
# checkout. Do not force-add new copies. Ignore rules do not untrack files
# already in history: eval/ and gold-set/snapshot.json stay because the
# default test suite loads them.
/eval/
/docs/validation/

# Playwright CLI page snapshots / console logs (local debugging scratch)
.playwright-cli/
.qoder