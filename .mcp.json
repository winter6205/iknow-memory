{
  "mcpServers": {
    "iknow-memory": {
      "command": "node",
      "args": ["../iknow-memory/dist/index.js"],
      "env": {
        "GRAPHRAG_MEMORY_EMBED_MODEL": "zhipueb/embedding-3",
        "GRAPHRAG_MEMORY_EMBED_DIMENSIONS": "2048",
        "GRAPHRAG_MEMORY_EMBED_API_KEY_ENV": "ANTHROPIC_AUTH_TOKEN",
        "GRAPHRAG_MEMORY_LOG_LEVEL": "info"
      }
    }
  }
}
