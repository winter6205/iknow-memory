{
  "name": "iknow-memory",
  "version": "0.0.0",
  "private": true,
  "description": "GraphRAG knowledge memory backend as an MCP server (MVP stage 0 scaffold).",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "extract": "bin/extract.js",
    "consolidate": "bin/consolidate.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "eval:retrieve": "node dist/cli/eval-retrieve.js",
    "extract": "node dist/cli/extract.js",
    "consolidate": "node dist/cli/consolidate.js",
    "graph:backfill": "node dist/cli/graph-backfill.js",
    "graph:drain": "node dist/cli/graph-drain.js",
    "prepare": "husky"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.115.0",
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "neo4j-driver": "^6.2.0",
    "pg": "^8.13.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.2.7"
  }
}
