{
  "name": "iknow-memory",
  "version": "0.0.0",
  "private": true,
  "description": "MCP memory service with hybrid retrieval and temporal validity.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/winter6205/iknow-memory.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "iknow-memory": "bin/iknow-memory.js",
    "iknow-memory-config": "bin/iknow-memory-config.js",
    "extract": "bin/extract.js",
    "embed-rotate": "bin/embed-rotate.js",
    "consolidate": "bin/consolidate.js",
    "eval": "bin/eval.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check:retrieval-baseline": "tsx scripts/check-retrieval-baseline.ts",
    "dev": "tsx src/index.ts",
    "dashboard-api": "tsx src/dashboard-api/main.ts",
    "dashboard:dev": "npm run dev --prefix dashboard",
    "dashboard:build": "npm run build --prefix dashboard",
    "dashboard": "tsx scripts/dashboard-dev.ts",
    "start": "node dist/index.js",
    "eval:retrieve": "node dist/cli/eval-retrieve.js",
    "eval:stack": "node dist/cli/eval-stack.js",
    "extract": "node dist/cli/extract.js",
    "consolidate": "node dist/cli/consolidate.js",
    "eval": "node dist/cli/eval.js",
    "gate:pr": "node dist/cli/eval.js --gate pr",
    "gate:release": "node dist/cli/eval.js --gate release",
    "graph:backfill": "node dist/cli/graph-backfill.js",
    "graph:drain": "node dist/cli/graph-drain.js",
    "community:summary": "node dist/cli/community-summary.js",
    "index:worker": "node dist/cli/index-job-worker.js",
    "embed:rotate": "node dist/cli/embed-rotate.js",
    "es:reindex": "node dist/cli/es-reindex.js",
    "prepare": "husky"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.115.0",
    "@elastic/elasticsearch": "^8.0.0",
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "neo4j-driver": "^6.2.0",
    "pg": "^8.13.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.0",
    "eslint": "^10.10.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^3.2.7"
  }
}
